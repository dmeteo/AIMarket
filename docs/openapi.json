            "type": "boolean",
            "title": "Is Active"
          },
          "orders_count": {
            "type": "integer",
            "title": "Orders Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role",
          "is_active",
          "orders_count"
        ],
        "title": "CurrentUserResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 50,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ProductCard": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images"
          },
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Price",
            "examples": [
              "199.99"
            ]
          },
          "discount_percent": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Discount Percent",
            "examples": [
              "10.5"
            ]
          },
          "final_price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Final Price",
            "examples": [
              "199.99"
            ]
          },
          "rating": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "examples": [
              4.8
            ]
          },
          "reviews_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Reviews Count"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "images",
          "price",
          "discount_percent",
          "final_price",
          "reviews_count",
          "quantity"
        ],
        "title": "ProductCard"
      },
      "ProductCreateRequest": {
        "properties": {
          "shop_id": {
            "type": "integer",
            "title": "Shop Id"
          },
          "title": {
            "type": "string",
            "maxLength": 30,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "title": "Description"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Price",
            "examples": [
              "100.99"
            ]
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "discount_percent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,3}|(?=[\\d.]{1,6}0*$)\\d{0,3}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Discount Percent",
            "default": 0,
            "examples": [
              "10.5"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Quantity"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          }
        },
        "type": "object",
        "required": [
          "shop_id",
          "title",
          "description",
          "images",
          "price",
          "categories",
          "quantity",
          "is_active"
        ],
        "title": "ProductCreateRequest"
      },
      "ProductCreateResponse": {
        "properties": {
          "product": {
            "$ref": "#/components/schemas/ProductPage"
          }
        },
        "type": "object",
        "required": [
          "product"
        ],
        "title": "ProductCreateResponse"
      },
      "ProductDeleteResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ProductDeleteResponse"
      },
      "ProductPage": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "shop_id": {
            "type": "integer",
            "title": "Shop Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Price",
            "examples": [
              "199.99"
            ]
          },
          "discount_percent": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Discount Percent",
            "examples": [
              "10.5"
            ]
          },
          "final_price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Final Price",
            "examples": [
              "199.99"
            ]
          },
          "rating": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "examples": [
              4.8
            ]
          },
          "reviews_count": {
            "type": "integer",
            "title": "Reviews Count"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/Review"
            },
            "type": "array",
            "title": "Reviews"
          }
        },
        "type": "object",
        "required": [
          "id",
          "shop_id",
          "title",
          "images",
          "description",
          "price",
          "discount_percent",
          "final_price",
          "reviews_count",
          "quantity",
          "categories",
          "reviews"
        ],
        "title": "ProductPage"
      },
      "ProductUpdateRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
